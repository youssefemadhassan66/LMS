# Core
NODE_ENV=production
PORT=3000

# Database
# Supply the complete URI through the deployment platform's secret manager.
CONNECTION_STRING=
MONGO_POOL_SIZE=10
MONGO_SELECT_TIMEOUT=10000
MONGO_SOCKET_TIMEOUT=45000

# Browser client and CORS (comma-separated origins are supported)
CORS_ORIGIN=https://your-frontend-domain.example
CLIENT_URL=https://your-frontend-domain.example

# Authentication
# Generate independent random secrets of at least 32 characters. Do not reuse them.
SALT_ROUNDS=12
JWT_TOKEN_SECRET=
JWT_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP email (required in production)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# First-admin bootstrap
# Leave EMPTY unless you are standing up a brand-new database. When set, it
# enables POST /api/v1/auth/bootstrap-admin, which creates the very first admin
# and then refuses forever once any admin exists. Send it as the
# x-bootstrap-secret header. Unset it again once the admin is created.
ADMIN_BOOTSTRAP_SECRET=
BOOTSTRAP_RATE_MAX=5

# Error responses
# Leave unset in every deployed environment. Set to "true" only on a local
# machine to get stack traces and the raw error object in API responses; it is
# ignored when NODE_ENV=production. Unset means callers see a status and a
# message and nothing about the server's internals.
EXPOSE_ERROR_DETAILS=

# Hosting
# Set to the exact number of trusted reverse-proxy hops for the chosen host.
TRUST_PROXY=1
LOG_TO_DISK=false

# Run the in-process scheduler in exactly one backend process.
SCHEDULER_ENABLED=true

# Optional AI summary provider
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=15000

# Application tuning
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=900000
REQUEST_TIMEOUT=30000
