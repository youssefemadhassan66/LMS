@Library('leroy-jenkins-library') _

pipeline {
    agent none

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        skipDefaultCheckout(true)

    }
    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Docker image tag supplied by orchestrator'
        )
    }

    environment {
        SERVICE_NAME     = 'backend'
        IMAGE_NAME       = 'lms-backend'
        INFRA_DIR        = '/git-repos/LMS_Infra'
        WORKDIR          = '/git-repos'
        TEST_DIR         = '/git-repos/LMS_Test'
        REPO_DIR        = '/git-repos/LMS'
    }

    stages {

        stage('Checkout Backend') {
            agent { docker {
                    image 'git-agent:latest'
                    args '-v git-repos:/git-repos -e HOME=/home/jenkins'
                }
            }
            steps {
                isValidGitDir("${TEST_DIR}")
            }
        }


        stage('Test'){
            agent { docker {
                    image 'node-agent:latest'
                    args '-v git-repos:/git-repos'
                }
            }
            steps {
                withCredentials([file(credentialsId: 'backend-env', variable: 'ENV_FILE')]) {
                    dir("${TEST_DIR}") {
                        sh """
                            cp "$ENV_FILE" .env
                            echo "=== DIRECTORY ==="
                            pwd
                            
                            echo "=== PACKAGE.JSON ==="
                            cat package.json
                            
                            echo "=== TEST SCRIPT ==="
                            npm pkg get scripts.test
                            
                            echo "=== JEST ==="
                            npm ls jest
                            
                            echo "=== VITEST ==="
                            npm ls vitest || true
                            
                            echo "=== VITE ==="
                            npm ls vite || true
                            
                            echo "=== RUNNING TEST ==="
                            npm test
                        """
                    }
                }

                sh """
                    rm -rf ${REPO_DIR}
                    mv ${TEST_DIR} ${REPO_DIR}
                    rm -rf ${TEST_DIR}
                """


            }
        }


        stage('Compose Build and Deploy') {
            agent { docker {
                    image 'docker-agent:latest'
                    args '''-v git-repos:/git-repos
                            -v /var/run/docker.sock:/var/run/docker.sock
                        '''
                }
            }
            steps {
                dir("${INFRA_DIR}") {
                    script {
                        sh """
                            echo "WORKDIR=$WORKDIR"
                            echo "INFRA_DIR=$INFRA_DIR"
                        """
                        composeBuild("${SERVICE_NAME}")
                        composeDeploy("${SERVICE_NAME}")
                    }
                }
            }
        }
    }
}
